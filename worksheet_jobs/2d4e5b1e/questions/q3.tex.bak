\begin{question}
\noindent Points $A$, $B$ and $C$ lie on the circumference of a circle with centre $O$, as shown in the diagram.

\begin{center}
\begin{tikzpicture}[scale=2]
    \coordinate (O) at (0,0);
    \coordinate (A) at (130:1);
    \coordinate (B) at (-30:1);
    \coordinate (C) at (250:1);

    \draw[fill=lightgray!20] (0,0) circle (1);
    \fill[black] (0,0) circle (1pt);

    \draw (O) -- (A);
    \draw (O) -- (B);
    \draw (A) -- (C);
    \draw (C) -- (B);

    \node[above left] at (A) {$A$};
    \node[right] at (B) {$B$};
    \node[below] at (C) {$C$};
    \node[above] at (O) {$O$};

    \pic [draw, angle eccentricity=1.5, angle radius = 0.5cm, "$80^\circ$"] {angle = A--O--B};
    \pic [draw, angle eccentricity=1.4, angle radius = 0.5cm, "$x$"] {angle = A--C--B};
\end{tikzpicture}
\end{center}

\noindent The angle at the centre, $\angle AOB = 80^\circ$.

\noindent Calculate the size of angle $x$, marked at the circumference.

\vspace{4cm}
\begin{flushright}
    \answerequnit{x}{$^\circ$}{2}
\end{flushright}
\end{question}
